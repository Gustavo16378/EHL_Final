# Copie para .env (ou defina no seu ambiente) antes de rodar: docker compose up -d

# URL do CMS usada no BUILD do front (Vite)
VITE_CMS_URL=http://localhost:1337

# Postgres (dev)
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=strapi

# Strapi secrets (gere valores fortes)
APP_KEYS=change_me_1,change_me_2
API_TOKEN_SALT=change_me
ADMIN_JWT_SECRET=change_me
TRANSFER_TOKEN_SALT=change_me
JWT_SECRET=change_me
ENCRYPTION_KEY=change_me

# CORS (se precisar acessar o front por outra origem)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
